TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Puedes usar token Bearer v4 (recomendado) o API key v3.
TMDB_API_TOKEN=
TMDB_API_KEY=

# Proveedores: streamingavailability o watchmode.
STREAMING_API_PROVIDER=streamingavailability
STREAMING_API_KEY=

COUNTRY=ES
LANGUAGE=es-ES
DAYS_AHEAD=7
MIN_TMDB_VOTE_COUNT=0
MAX_ITEMS_PER_MESSAGE=8
MAX_STREAMING_PAGES=3
INCLUDE_SERIES=true

# Streaming Availability usa IDs de catalogo. Consulta /countries si un ID cambia.
STREAMING_CATALOGS=netflix,prime,disney,hbo,movistar,filmin,apple,skyshowtime

# Watchmode: opcional. IDs numericos devueltos por /v1/sources/.
WATCHMODE_SOURCE_IDS=
